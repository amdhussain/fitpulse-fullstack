NODE_ENV=development
PORT=5000

CLIENT_URL=http://localhost:5173

MONGODB_URI=your-mongodb-connection-string
MONGODB_DB=fitpulse_db

JWT_EXPIRES_IN=7d
BETTER_AUTH_SECRET=change-this-to-a-secure-random-string
BETTER_AUTH_URL=http://localhost:5000

COOKIE_SECRET=change-this-to-a-secure-random-string
COOKIE_MAX_AGE=86400000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Google OAuth (for Google Sign-In/Sign-Up)

GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here


# ─── Render Production Environment Variables ────────────────
# When deploying to Render, set these in the Render Dashboard:
#
# NODE_ENV=production
# CLIENT_URL=https://your-frontend-domain.vercel.app
# BETTER_AUTH_URL=https://fitpulse-fullstack-jtkc.onrender.com
# GOOGLE_CLIENT_ID=1020041157414-a8eb1g05ia480l76tvo8mama59v3u7kd.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=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
#
# Then add this exact redirect URI in Google Cloud Console:
# https://fitpulse-fullstack-jtkc.onrender.com/api/v1/auth/google/callback
